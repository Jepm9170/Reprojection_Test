{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  "VendorApi": {
    "BaseUrl": "https://vendor-api.example.com/",
    "TimeoutSeconds": 60,

    "Auth": {
      "Scheme": "ApiKey",
      "HeaderName": "X-Api-Key",
      "ApiKey": ""
    },

    "Endpoints": {
      "GetPolicyData": "api/v1/policies/{policyNumber}",
      "RunReprojection": "api/v1/reprojections"
    },

    "UseMockData": true,
    "MockDataFolder": "MockData"
  }
}
